def getPulseToken() {
    def token
    echo "Getting Pulse token..."

    sh "apk update"
    sh "apk add curl jq wget python3 py3-pip"

    withCredentials([usernamePassword(credentialsId: 'pulse-client-credentials',
                                      usernameVariable: 'CLIENT_ID',
                                      passwordVariable: 'CLIENT_SECRET')]) {
        token = sh(script: """
            curl --location --request POST 'https://x9thwm-cootr2q1jdv5p7b8iw4fs4ob3x6nqqsoznyk.ssa.nvidia.com/token' \
                --user "$CLIENT_ID:$CLIENT_SECRET" \
                --header 'Content-Type: application/x-www-form-urlencoded' \
                --data-urlencode 'grant_type=client_credentials' \
                --data-urlencode 'scope=nspect.verify scan.anchore' | jq -r '.access_token'
        """, returnStdout: true).trim()
    }

    echo "${token}"
    return token
}


podTemplate (cloud:'sc-ipp-blossom-prod', yaml : """
apiVersion: v1
kind: Pod
metadata:
  labels:
    some-label: some-label-value
spec:
  imagePullSecrets:
  - name: svc-tlt-ci-ngcimagepullsecret
  - name: gitlab-tao-imagepullsecret
  containers:
  - name: docker
    image: docker:24.0.5-dind
    securityContext:
      privileged: true
    resources:
      requests:
        memory: "32Gi"
      limits:
        memory: "64Gi"
    env:
      - name: DOCKER_TLS_CERTDIR
        value: ""
  - name: base-image
    image: nvcr.io/nvstaging/tao/tao_pytorch_base_image@sha256:01a704ebc77a0a99c2b3b73a970b187edcc0823572455344130960dee6ef1899
    securityContext:
      privileged: true
    command:
    - cat
    resources:
      requests:
        nvidia.com/gpu: 1
        memory: "16Gi"
      limits:
        nvidia.com/gpu: 1
        memory: "64Gi"
    tty: true
  restartPolicy: Never
  backoffLimit: 4
  nodeSelector:
    kubernetes.io/os: linux
    nvidia.com/gpu_type: A40
    nvidia.com/driver_version: "525.60.13"
""") {
  node(POD_LABEL) {
    try {
      container('base-image') {
        def command_env = ''

        stage ('checkout') {
          gitlabCommitStatus(name: "checkout", connection: gitLabConnection('git-lab-master')) {
            checkout scm
            // Adding this since 22.05+ containers need this in git.
            sh "git config --global --add safe.directory $WORKSPACE && ls -lrt"
          }
        }

        stage ('setup') {
          gitlabCommitStatus(name: "setup", connection: gitLabConnection('git-lab-master')) {
            sh "ls -rlt ./"
            sh "ls -lh ./tests/" // check if lfs pull is successfull
            sh "source scripts/envsetup.sh"
            def workspace_path = pwd()
            def pythonpath_env = 'PYTHONPATH=' + workspace_path + ':$PYTHONPATH'
            def ci_path_env = 'CI_PROJECT_DIR=' + workspace_path
            command_env = pythonpath_env + ' ' + ci_path_env
          }
        }

        stage ('setup_scratch_space') {
          sh 'apt-get update'
          sh 'apt-get install cifs-utils -y'
          sh 'env | sort'
          sh 'mkdir -p /home/scratch.metropolis2'
          sh 'ls -l /home/scratch.metropolis2'
          withCredentials([usernamePassword(credentialsId: 'svc-tlt-ci-mount', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]){
            sh 'mount -t cifs -o "vers=2.0,username=${USERNAME},password=${PASSWORD},dom=nvidia.com,dir_mode=0777,file_mode=0777" //dc2-cdot49-sw-svm02/scratch.metropolis2 /home/scratch.metropolis2'
          }
          sh 'ls -l /home/scratch.metropolis2'
        }
      }

      container("docker"){
        stage ('setup_scratch_space_in_dind') {
          sh 'uname -a'
          sh 'apk update'
          sh 'apk add cifs-utils python3 py3-pip'
          sh 'python3 -V'
          sh 'python3 -m pip install pyyaml'
          sh 'ls /sbin/mount.cifs'
          sh 'env | sort'
          sh 'ls -lrt; pwd'
          sh 'df -h'
          sh 'mkdir -p /home/scratch.metropolis2'
          sh 'ls -l /home/scratch.metropolis2'
          withCredentials([usernamePassword(credentialsId: 'svc-tlt-ci-mount', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]){
            sh 'mount -t cifs -o "vers=2.0,username=${USERNAME},password=${PASSWORD},dom=nvidia.com,dir_mode=0777,file_mode=0777" //dc2-cdot49-sw-svm02/scratch.metropolis2 /home/scratch.metropolis2'
          }
          sh 'df -h'
          sh 'ls -l /home/scratch.metropolis2'
        }

        stage ('checkmarx-scans') {
          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            withCredentials([usernamePassword(credentialsId: 'checkmarx-ac-account', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]){
              withEnv([
              "CHECKMARX_USERNAME=${USERNAME}",
              "CHECKMARX_PASSWORD=${PASSWORD}",
              "CX_TEAM=CxServer/SP/Company/TLT",
              "CX_PROJECT=TAO-PyTorch",
              "CHECKMARX_BASE_URL=https://checkmarx.nvidia.com",
              "CHECKMARX_VERSION=9.0",
              "CHECKMARX_SETTINGS_OVERRIDE=false",
              "CHECKMARX_CONFIGURATION=Default Configuration",
              "CHECKMARX_SCAN_PRESET=Checkmarx Default",
              "CX_FLOW_BREAK_BUILD=true",
              "CX_FLOW_ZIP_EXCLUDE=.git*,.github,dist\\/.*,allowlist\\/.*,ci\\/.*,docker\\/.*,runner\\/.*,tests\\/.*,release\\/.*,scripts\\/.*,third_party\\/.*,tao-converter\\/.*,tao-core\\/.*",
              "CX_PARAMS=''"
              ]){
                docker.withRegistry('https://gitlab-master.nvidia.com:5005', 'jenkins-TLT-pkg') {
                  def img = 'pstooling/images/base-images/debian:cxflow-latest-prodsec-stable'
                  docker.image(img).inside("--entrypoint=''") {
                    sh '/app/check_variables.sh jenkins'
                    sh """
                    java -jar /app/cx-flow.jar \
                    --scan \
                    --bug-tracker="Csv" \
                    --csv.file-name-format="[TEAM]-[PROJECT]-[TIME].csv" \
                    --csv.include-headers="true" \
                    --csv.data-folder="checkmarx" \
                    --app="${CX_PROJECT}" \
                    --cx-team="${CX_TEAM}" \
                    --cx-project="${CX_PROJECT}" \
                    --spring.profiles.active="sast" \
                    --f=. \
                    ${CX_PARAMS}
                    """
                    sh '/app/check_timeout.sh'
                  }
                }
              }
            }
          }
        }
      }
      
      container('base-image') {
        def workspace_path = pwd()
        def pythonpath_env = 'PYTHONPATH=' + workspace_path + ':$PYTHONPATH'
        def ci_path_env = 'CI_PROJECT_DIR=' + workspace_path
        command_env = pythonpath_env + ' ' + ci_path_env

        stage ('static_tests') {
          gitlabCommitStatus(name: "static_tests", connection: gitLabConnection('git-lab-master')) {
            sh "${command_env} python3 ci/run_static_tests.py"
          }
        }

        stage ("functional_tests") {
          withCredentials([string(credentialsId: 'NGC_CLI_API_KEY_SVC_TLT_CI', variable: 'NGC_CLI_API_KEY')]) {
            script{
              env.NGC_KEY=NGC_CLI_API_KEY
              env.NGC_PATH='ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
            }
          }
          gitlabCommitStatus(name: "functional_tests", connection: gitLabConnection('git-lab-master')) {
            echo "starting functional test . . ."
            sh "pip install pytest-cov"
            sh "python setup.py develop"
            sh "CPUCOUNT=1 pip install tao-core/"
            // Running functional tests with coverage reporting.
            // Steps run in the following order:
            // 1. cv_unit
            // 2. sdg_unit
            // 3. distributed
            // 4. ssl_unit_test
            sh "${command_env} python ci/run_functional_tests.py -m 'cv_unit' --cov=nvidia_tao_pytorch --cov-report="
            sh "cp .coverage /home/scratch.metropolis2/users/release_pipeline_files/coverage_reports/functional_test/.coverage.fn_pyt"
            sh "${command_env} python ci/run_functional_tests.py -m 'sdg_unit' --cov=nvidia_tao_pytorch --cov-report="
            sh "cat .coverage >> /home/scratch.metropolis2/users/release_pipeline_files/coverage_reports/functional_test/.coverage.fn_pyt"
            sh "${command_env} pytest -v --color=yes tests/distributed --cov=nvidia_tao_pytorch --cov-report="
            sh "cat .coverage >> /home/scratch.metropolis2/users/release_pipeline_files/coverage_reports/functional_test/.coverage.fn_pyt"
            sh "${command_env} pytest -v --color=yes tests/ssl_unit_test --cov=nvidia_tao_pytorch --cov-report="
            sh "cat .coverage >> /home/scratch.metropolis2/users/release_pipeline_files/coverage_reports/functional_test/.coverage.fn_pyt"
          }
        }

        stage ('build_wheel') {
          gitlabCommitStatus(name: "build_wheel", connection: gitLabConnection('git-lab-master')) {
            // Building the wheels for the tao source code.
            def TAO_WHEEL_VERSION="5.2.0"
            def BUILD_TYPE="dev"
            def VER="${TAO_WHEEL_VERSION}.${BUILD_NUMBER}.${BUILD_TYPE}0"
            sh "echo '${BUILD_NUMBER}-${BUILD_TYPE}' > build.info"
            build_env = command_env
            sh "${build_env} python setup.py bdist_wheel"
            sh "pip install dist/nvidia_tao_pytorch-*.whl"
          }
        }
      }

      container('base-image') {
        def workspace_path = pwd()
        def pythonpath_env = 'PYTHONPATH=' + workspace_path + ':$PYTHONPATH'
        def ci_path_env = 'CI_PROJECT_DIR=' + workspace_path
        command_env = pythonpath_env + ' ' + ci_path_env

        stage ('wheel_publish') {
          gitlabCommitStatus(name: "obfuscated_wheel_publish", connection: gitLabConnection('git-lab-master')) {
            // install jfrog first
            sh "bash ${WORKSPACE}/docker/install_jfrog.sh"
            def TAO_WHEEL_VERSION="5.2.0"
            def BUILD_TYPE="dev"
            def VER="${TAO_WHEEL_VERSION}.${BUILD_NUMBER}.${BUILD_TYPE}0"
            def PYTHON_VER="cp312-cp312"
            def ARCH="linux_x86_64"
            def SRC="dist/nvidia_tao_pytorch-${VER}-${PYTHON_VER}-${ARCH}.whl"
            def TARGET="sw-tao-pypi-local/nvidia-tao-pytorch/${VER}/"
            def PROP="component_name=nvidia-tao-pytorch;arch=x86_64;os=linux;build_source=None;version=${VER};branch=main;release_approver=vpraveen"
            withCredentials([usernamePassword(credentialsId: 'tao-artifactory-tkn', passwordVariable: 'JFROG_PASSWORD', usernameVariable: 'JFROG_USERNAME')]) {
              sh "jfrog rt u --url=https://urm.nvidia.com/artifactory/ --user=${JFROG_USERNAME} --access-token=${JFROG_PASSWORD} --target-props '${PROP}' ${SRC} ${TARGET}"
            }
            def append_string="pytorch_wheel: nvidia_tao_pytorch-${VER}-${PYTHON_VER}-${ARCH}.whl"
            def config_file_path = "/home/scratch.metropolis2/users/release_pipeline_files/release_items.yml"
            sh "python3 ci/update_release_config.py ${config_file_path} '${append_string}'"
            sh "cat /home/scratch.metropolis2/users/release_pipeline_files/release_items.yml"
          }
        }
        
        stage ('publish_release_artifacts') {
          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            gitlabCommitStatus(name: "publish_release_artifacts", connection: gitLabConnection('git-lab-master')) {
            withCredentials([string(credentialsId: 'gitlab-api-token', variable: 'GITLAB_TOKEN')]) {
                def MAIN_WORKSPACE="${WORKSPACE}"
                def GITLAB_PROJECT_ID = "140276"
                def TAG_NAME = "Artifacts"
                def RELEASE_NAME = "Release Artifacts"
                def RELEASE_DESCRIPTION = "Release artifacts with third-party packages"

                echo "Updating dependencies..."

                sh """
                        set -x
                        python3 -m pip install requests
                    """

                try {
                    sh """
                        set -x
                        # Configure APT source repositories for source package downloads
                        echo "Configuring APT source repositories..."
                        mkdir -p /etc/apt/sources.list.d || true
                        SOURCES_FILE=/etc/apt/sources.list.d/jenkins-deb-src.list
                        echo "Writing deb-src lines to ${SOURCES_FILE}..."
                        cat <<-EOF > ${SOURCES_FILE} || (echo "Failed to write to ${SOURCES_FILE}, checking permissions" && ls -la /etc/apt/sources.list.d/)
    deb-src http://archive.ubuntu.com/ubuntu/ jammy main restricted universe multiverse
    deb-src http://archive.ubuntu.com/ubuntu/ jammy-updates main restricted universe multiverse
    deb-src http://archive.ubuntu.com/ubuntu/ jammy-backports main restricted universe multiverse
    deb-src http://security.ubuntu.com/ubuntu jammy-security main restricted universe multiverse
    EOF
                        apt-get update || echo "apt-get update failed, continuing anyway"
                        python3 -m pip --version || (apt-get update && apt-get install -y python3-pip)
                        python3 -m pip install --upgrade pip
                        echo "Installing requests library..."
                        python3 -m pip install requests
                    """
                } catch (Exception e) {
                    echo "Error during APT setup: ${e.getMessage()}"
                    echo "Continuing anyway..."
                }

                echo "Publishing release artifacts..."

                try {
                    sh """
                    set -x
                    # Check if git is installed, if not install it
                    command -v git >/dev/null 2>&1 || { echo "Installing git..."; apt-get update && apt-get install -y git; }

                    # Verify GITLAB_TOKEN is set (without printing it)
                    if [ -z "${GITLAB_TOKEN}" ]; then
                        echo "ERROR: GITLAB_TOKEN is empty!"
                        exit 1
                    else
                        echo "GITLAB_TOKEN is set and not empty"
                    fi

                    # Test access to GitLab before attempting clone
                    curl -s -I -H "Authorization: Bearer ${GITLAB_TOKEN}" https://gitlab-master.nvidia.com/api/v4/projects | grep -q "HTTP/2 200" && echo "GitLab API access successful" || echo "GitLab API access failed"

                    # Clone using GitLab token for authentication
                    git clone https://oauth2:${GITLAB_TOKEN}@gitlab-master.nvidia.com/nvidia-tao-toolkit/tao-third-party-packages.git third-party-manager
                    """
                } catch (Exception e) {
                    echo "Error during git operations: ${e.getMessage()}"
                    error("Failed at git clone stage")
                }

                try {
                    sh """
                    set -x
                    cd third-party-manager
                    python3 manage_third_party.py \
                        --enable-wheels \
                        --enable-apt \
                        --python-requirements "${MAIN_WORKSPACE}/docker/requirements-pip.txt" \
                        --apt-requirements "${MAIN_WORKSPACE}/docker/requirements-apt.txt" \
                        --gitlab-project-id ${GITLAB_PROJECT_ID} \
                        --tag-name ${TAG_NAME} \
                        --gitlab-token ${GITLAB_TOKEN} \
                        --release-name "${RELEASE_NAME}" \
                        --release-description "${RELEASE_DESCRIPTION}" \
                        --wheels-dir "third_party_wheels" \
                        --apt-dir "third_party_apt" \
                        --apt-sources-dir "third_party_apt_sources" \
                        --gitlab-timeout 60 \
                        --gitlab-retries 3
                    """
                } catch (Exception e) {
                    echo "Error during third-party package management: ${e.getMessage()}"
                    error("Failed during package management")
                }

                echo "Cleaning up workspace..."
                sh 'rm -rf third_party_wheels third_party_apt third_party_apt_sources || true'
            }
            }
          }
        }

        stage ('cleanup_scratch_space') {
          sh 'umount /home/scratch.metropolis2'
          sh 'ls -l /home/scratch.metropolis2'
        }
      }

      container("docker") {
        def TAO_VERSION = "5.2.0"
        def IMAGE_NAME = "nvcr.io/nvstaging/tao/tao-toolkit-pyt"
        def CUDA_VERSION = "12.8"

        stage ('release_docker_build') {
          retry(count: 3) {
            // on retries, wait 5 min before re-running
            script {
              if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                echo "Previous attempt failed, sleeping 5 minutes before retry..."
                sleep time: 5, unit: 'MINUTES'
              }
            }
            gitlabCommitStatus(name: "release_docker_build", connection: gitLabConnection('git-lab-master')) {
              withEnv(["TAO_VERSION=${TAO_VERSION}", "IMAGE_NAME=${IMAGE_NAME}", "CUDA_VERSION=${CUDA_VERSION}"]) {
                docker.withRegistry('https://nvcr.io', 'NGC_API_KEY') {
                  sh "docker build -t ${IMAGE_NAME}:v${TAO_VERSION}-${BUILD_NUMBER}-dev-cuda${CUDA_VERSION} --network=host -f ${WORKSPACE}/release/docker/Dockerfile ${WORKSPACE}"
                  sh "docker push ${IMAGE_NAME}:v${TAO_VERSION}-${BUILD_NUMBER}-dev-cuda${CUDA_VERSION}"

                  def append_string="pytorch: ${IMAGE_NAME}:v${TAO_VERSION}-${BUILD_NUMBER}-dev-cuda${CUDA_VERSION}"
                  def config_file_path = "/home/scratch.metropolis2/users/release_pipeline_files/release_items.yml"
                  sh "python3 ci/update_release_config.py ${config_file_path} '${append_string}'"
                  sh "cat /home/scratch.metropolis2/users/release_pipeline_files/release_items.yml"
                }
              }
            }
          }
        }

        stage ('docker_coverage_build') {
          retry(count: 3) {
             // on retries, wait 5 min before re-running
            script {
              if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                echo "Previous attempt failed, sleeping 5 minutes before retry..."
                sleep time: 5, unit: 'MINUTES'
              }
            }
            withEnv(["TAO_VERSION=${TAO_VERSION}", "IMAGE_NAME=${IMAGE_NAME}", "CUDA_VERSION=${CUDA_VERSION}"]) {
              docker.withRegistry('https://nvcr.io', 'NGC_API_KEY') {
                sh "cat coverage_build.txt >> ${WORKSPACE}/release/docker/Dockerfile"
                sh "cat ${WORKSPACE}/release/docker/Dockerfile"
                sh "docker build -t ${IMAGE_NAME}:v${TAO_VERSION}-${BUILD_NUMBER}-dev-cuda${CUDA_VERSION}-cc --network=host -f ${WORKSPACE}/release/docker/Dockerfile ${WORKSPACE}"
                sh "docker push ${IMAGE_NAME}:v${TAO_VERSION}-${BUILD_NUMBER}-dev-cuda${CUDA_VERSION}-cc"

                def append_string="pytorch: ${IMAGE_NAME}:v${TAO_VERSION}-${BUILD_NUMBER}-dev-cuda${CUDA_VERSION}-cc"
                def config_file_path = "/home/scratch.metropolis2/users/release_pipeline_files/coverage_tags.yml"
                sh "python3 ci/update_release_config.py ${config_file_path} '${append_string}'"
                sh "cat /home/scratch.metropolis2/users/release_pipeline_files/coverage_tags.yml"
              }
            }
          }
        }

        stage ('create_manifest') {
          gitlabCommitStatus(name: "create_manifest", connection: gitLabConnection('git-lab-master')) {
            withEnv(["TAO_VERSION=${TAO_VERSION}", "IMAGE_NAME=${IMAGE_NAME}", "CUDA_VERSION=${CUDA_VERSION}"]) {
              docker.withRegistry('https://nvcr.io', 'NGC_API_KEY') {
                sh "docker buildx imagetools create -t ${IMAGE_NAME}:nightly ${IMAGE_NAME}:v${TAO_VERSION}-${BUILD_NUMBER}-dev-cuda${CUDA_VERSION}"
              }
            }
          }
        }

        // Todo: @achafale to uncomment after issue in the prod-sec code-base has been resolved
        // stage ('pulse_oss_scan') {
        //   gitlabCommitStatus(name: "pulse_oss_scan", connection: gitLabConnection('git-lab-master')) {
        //     withEnv(["TAO_VERSION=5.2.0", "IMAGE_NAME=nvcr.io/nvstaging/tao/tao-toolkit-pyt", "CUDA_VERSION=12.2"]) {
        //       docker.withRegistry('https://nvcr.io', 'NGC_API_KEY') {
        //         docker.withRegistry('https://gitlab-master.nvidia.com:5005', 'jenkins-TLT-pkg') {
        //           def NSPECT_ID="NSPECT-76DN-OP7I"
        //           def SSA_TOKEN=getPulseToken()
        //           def CONTAINER_TAG="${IMAGE_NAME}:v${TAO_VERSION}-${BUILD_NUMBER}-dev-cuda${CUDA_VERSION}"
        //           def CONTAINER_ARCHIVE="container_image.tar"
        //           def CONTAINER_SCAN_POLICY="allowlist/tao_24_03_sec_policy_v2.json"
        //           try {
        //             sh """
        //               docker save ${CONTAINER_TAG} > ${CONTAINER_ARCHIVE}
        //               wget https://raw.githubusercontent.com/achafale/Jenkins-CI/main/policy.json
        //               ls -al
        //               docker run -v .:/dist -w /dist gitlab-master.nvidia.com:5005/pstooling/pulse-group/pulse-container-scanner/pulse-cli:stable /bin/sh -c "pulse-cli -n $NSPECT_ID --ssa $SSA_TOKEN scan -i $CONTAINER_ARCHIVE -p $CONTAINER_SCAN_POLICY -o || true"
        //             """
        //           } catch (Exception e) {
        //             echo "Continuing with the pipeline..."
        //             echo "An error occurred: ${e.getMessage()}"
        //           }
        //           execution_script = '''
        //             wget https://raw.githubusercontent.com/achafale/Jenkins-CI/main/vulnerabilities_validation.py
        //             ls -al
        //             python3 -m pip install pandas
        //             python3 vulnerabilities_validation.py
        //           '''
        //           def shellOutput = sh(script: execution_script, returnStdout: true).toString()
        //           echo shellOutput
        //           if (shellOutput.contains("Scan result : FAIL")) {
        //             error("Unsuccessful Execution . . .")
        //           }
        //           sh "rm -rf ${CONTAINER_ARCHIVE}"
        //         }
        //       }
        //     }
        //   }
        // }

        stage ('cleanup_scratch_space_in_dind') {
          sh 'umount /home/scratch.metropolis2'
          sh 'ls -l /home/scratch.metropolis2'
        }
      }
    }
    
    catch(e) {
      // Mark build as failed.
      currentBuild.result = 'FAILURE'

      container('base-image') {
        stage("Jira Notification on Failure") {
          withCredentials([string(credentialsId: 'TAO-jira-token', variable: 'jira_token')]) {
            sh """
              python3 -m pip install jira
              python3 ci/create_jira_issue.py --jira_server "https://jirasw.nvidia.com/" \\
              --username "achafale@nvidia.com" \\
              --api_token "${jira_token}" \\
              --project_key "TLT" \\
              --summary "Pipeline '${JOB_NAME}' Failure" \\
              --description \$'The pipeline "${JOB_NAME}" has failed.\nLink to the build: https://prod.blsm.nvidia.com/metropolis-iva-tlt-jenkins/view/tao-pytorch/job/${JOB_NAME}' \\
              --issue_type "Bug"
            """
          }
        }
      }
      
      // Rethrow the error so the build is marked as failed.
      throw e
    }
  }
}
