@Library('tao-jenkins-shared-library') _
import org.tao.PodTemplates
import org.tao.TaoConfig

// ============================================================================
// PROJECT INITIALIZATION
// ============================================================================

TaoConfig.init([
    projectName: 'tao-pytorch',
    
    // CI author info
    ciAuthorName: 'TAO Release CI',
    ciAuthorEmail: 'christwang@nvidia.com',
    podLabelPrefix: 'tao-pytorch-release',    
    // Registries
    registries: [
        NGC: [
            url: 'https://nvcr.io',
            host: 'nvcr.io',
            stagingOrg: 'nvstaging/tao',
            prodOrg: 'nvstaging/tao'
        ],
        GITLAB: [
            url: 'https://gitlab-master.nvidia.com',
            connection: 'git-lab-master'
        ],
        ARTIFACTORY: [
            url: 'https://artifactory.nvidia.com/artifactory/',
            pypiRepo: 'sw-tao-pypi-local'
        ]
    ],
    
    // Credentials
    credentials: [
        NGC_API_KEY: 'NGC_API_KEY',
        NGC_CLI_KEY: 'NGC_CLI_API_KEY_SVC_TLT_CI',
        GITLAB_TOKEN: 'gitlab-api-token',
        ARTIFACTORY: 'tao-artifactory-tkn-christwang',
        SCRATCH_MOUNT: 'svc-tlt-ci-mount',
        HF_TOKEN: 'HF_TOKEN_CI',
        JENKINS_API_TOKEN: 'jenkins-api-token'
    ],
    
    // Docker images
    images: [
        BASE_IMAGE_X86: 'nvcr.io/nvstaging/tao/tao_pytorch_base_image@sha256:0d87a5916f61f2713bbb15341c9dea0c7bb8724decc68511e028139855c75832',
        BASE_IMAGE_ARM64: 'nvcr.io/nvstaging/tao/tao_pytorch_base_image@sha256:09b7b581184fb9001953719862827980b64a19adc5bed12bad5f05952e441587',
        DOCKER_DIND: 'docker:24.0.5-dind',
        SONAR_SCANNER: 'sonarsource/sonar-scanner-cli:11',
        IMAGE_NAME_PYT: 'nvcr.io/nvstaging/tao/tao-toolkit-pyt',
        IMAGE_NAME_TOOLKIT: 'nvcr.io/nvstaging/tao/tao-toolkit'
    ],
    
    // Kubernetes
    kubernetes: [
        cloud: 'sc-ipp-blossom-prod',
        imagePullSecrets: ['svc-tlt-ci-ngcimagepullsecret', 'gitlab-tao-imagepullsecret']
    ],
    
    // GitLab project
    gitlab: [
        projectId: 'nvidia-tao-toolkit/tao-pytorch'
    ]
])

// Initialize PodTemplates
PodTemplates.init([
    imagePullSecrets: TaoConfig.kubernetes.imagePullSecrets,
    
    containers: [
        'dind-image': [
            image: TaoConfig.images.DOCKER_DIND,
            privileged: true,
            resources: [
                requests: [memory: '32Gi'],
                limits: [memory: '64Gi']
            ],
            env: [DOCKER_TLS_CERTDIR: '']
        ],
        'cuda-x86': [
            image: TaoConfig.images.BASE_IMAGE_X86,
            privileged: true,
            command: ['cat'],
            tty: true,
            resources: [
                requests: ['nvidia.com/gpu': 1, memory: '16Gi'],
                limits: ['nvidia.com/gpu': 1, memory: '64Gi']
            ]
        ],
        'cuda-arm64': [
            image: TaoConfig.images.BASE_IMAGE_ARM64,
            privileged: true,
            command: ['cat'],
            tty: true,
            resources: [
                requests: ['nvidia.com/gpu': 1, memory: '16Gi'],
                limits: ['nvidia.com/gpu': 1, memory: '64Gi']
            ]
        ],
        'docker-consolidate': [
            image: TaoConfig.images.DOCKER_DIND,
            privileged: true,
            resources: [
                requests: [memory: '8Gi'],
                limits: [memory: '16Gi']
            ],
            env: [DOCKER_TLS_CERTDIR: '', OTEL_SDK_DISABLED: 'true']
        ],
        'checkout-container': [
            image: TaoConfig.images.BASE_IMAGE_X86,
            privileged: false,
            command: ['cat'],
            tty: true,
            resources: [
                requests: [memory: '4Gi'],
                limits: [memory: '8Gi']
            ]
        ]
    ],
    
    affinityPools: [
        'tao-gpu-x86-pool': [
            gpuTypes: ['A100_80GB_PCIE', 'A100_PCIE_40GB', 'A40', 'L40'],
            driverVersions: ['580.35', '580.66', '580.82.07', '580.95.05'],
            os: 'linux',
            arch: 'amd64'
        ],
        'tao-gpu-arm64-pool': [
            gpuTypes: ['NVIDIA_GH200_480GB'],
            driverVersions: [],
            os: 'linux',
            arch: 'arm64'
        ],
        'docker-only': [
            gpuTypes: [],
            driverVersions: [],
            os: 'linux',
            arch: null
        ]
    ]
])

// ============================================================================
// PIPELINE PARAMETERS
// ============================================================================

def TAO_VERSION = params.TAO_VERSION ?: "6.25.10"
def BUILD_TYPE = "rc"

// Normalize version
TAO_VERSION = normalizeVersion(TAO_VERSION)

// Parse version components
def VERSION_PARTS = TAO_VERSION.split('\\.')
def MAJOR_MINOR = "${VERSION_PARTS[0]}.${VERSION_PARTS[1]}"
def PATCH_NUMBER = VERSION_PARTS[-1]

// Build version strings
// RC version format: 6.25.13rc158 (no dot before 'rc' per PEP 440)
def VER = params.RC ? "${MAJOR_MINOR}.${PATCH_NUMBER}${BUILD_TYPE}${env.BUILD_NUMBER}" : TAO_VERSION
def FINAL_VER = "${MAJOR_MINOR}.${PATCH_NUMBER}"

// Component configuration
def COMPONENT_NAME = 'nvidia-tao-pytorch'
def RELEASE_APPROVER = 'vpraveen'
def SKIP_PROD_PROMOTE = params.SKIP_PROD_PROMOTE ?: false

// Store wheel install locations for metadata (shared across stages)
def rcWheelInstallLocation = ""
def finalWheelInstallLocation = ""

// ============================================================================
// PIPELINE
// ============================================================================

pipeline {
    agent none
    
    parameters {
        string(name: 'TAO_VERSION', defaultValue: '6.25.10', description: 'TAO version to build')
        booleanParam(name: 'RC', defaultValue: true, description: 'Build RC version')
        booleanParam(name: 'FORCE_REBUILD', defaultValue: false, description: 'Force rebuild even if no code changes')
        booleanParam(name: 'SKIP_PROD_PROMOTE', defaultValue: false, description: 'Skip final wheel publish and production image tagging')
        booleanParam(name: 'SKIP_TEST', defaultValue: false, description: 'Skip functional tests')
        string(name: 'GITLAB_BRANCH', defaultValue: '', description: 'GitLab branch for SonarQube (auto-detected if empty)')
        string(name: 'GITLAB_REPO_URL', defaultValue: 'https://gitlab-master.nvidia.com/nvidia-tao-toolkit/tao-pytorch.git', description: 'GitLab repository URL')
    }
    
    stages {
        // ================================================================
        // PRELIMINARY STAGE: Update submodule and detect skip build
        // ================================================================
        stage('update_submodule_and_detect_skip_build') {
            agent {
                kubernetes {
                    cloud TaoConfig.kubernetes.cloud
                    yaml PodTemplates.generate(
                        label: 'tao-pytorch-prelim',
                        containers: ['checkout-container'],
                        affinityPool: 'docker-only'
                    )
                }
            }
            
            stages {
                stage('checkout') {
                    steps {
                        container('checkout-container') {
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                withGitLabStatus('checkout') {
                                    checkoutWithSafeDirectory()
                                }
                            }
                        }
                    }
                }
                
                stage('update_core_submodule') {
                    steps {
                        container('checkout-container') {
                            catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
                                withGitLabStatus('update_core_submodule') {
                                    script {
                                        withCredentials([string(credentialsId: TaoConfig.credentials.GITLAB_TOKEN, variable: 'GITLAB_TOKEN')]) {
                                            updateSubmoduleAndPush(
                                                submoduleName: 'tao-core',
                                                version: TAO_VERSION,
                                                gitToken: GITLAB_TOKEN,
                                                repoPath: 'nvidia-tao-toolkit/tao-pytorch',
                                                submoduleUrl: 'https://gitlab-master.nvidia.com/nvidia-tao-toolkit/tao-core.git'
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                
                stage('detect_skip_build') {
                    steps {
                        container('checkout-container') {
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                withGitLabStatus('detect_skip_build') {
                                    script {
                                        def skipResult = detectSkipBuild.checkAndSetEnv(
                                            taoVersion: TAO_VERSION,
                                            isRC: params.RC,
                                            forceRebuild: params.FORCE_REBUILD
                                        )
                                        
                                        if (skipResult.shouldSkip) {
                                            echo "⏭ Build can be skipped - no code changes detected"
                                            env.SKIP_BUILD = 'true'
                                        } else {
                                            echo "✓ Proceeding with full build"
                                            env.SKIP_BUILD = 'false'
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        
        // ================================================================
        // MULTI-ARCH PARALLEL BUILD
        // ================================================================
        stage('Multi-Arch Release Build') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            failFast false
            parallel {
                // ================================================================
                // X86 BUILD
                // ================================================================
                stage('x86') {
                    agent {
                        kubernetes {
                            cloud TaoConfig.kubernetes.cloud
                            yaml PodTemplates.generate(
                                label: 'tao-pytorch-release-x86',
                                containers: ['dind-image', 'cuda-x86'],
                                affinityPool: 'tao-gpu-x86-pool'
                            )
                        }
                    }
                    
                    stages {
                        stage('x86_checkout') {
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('x86_checkout') {
                                            checkoutWithSafeDirectory()
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('x86_gpu_check') {
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('x86_gpu_check') {
                                            gpuCheck()
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('x86_setup') {
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('x86_setup') {
                                            script {
                                                sh "source scripts/envsetup.sh"
                                                def workspace_path = pwd()
                                                env.COMMAND_ENV_X86 = "PYTHONPATH=${workspace_path}:\$PYTHONPATH CI_PROJECT_DIR=${workspace_path}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('x86_patch_build_files') {
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('x86_patch_build_files') {
                                            patchVersion(
                                                version: TAO_VERSION,
                                                script: 'release/update_version.py'
                                            )
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('x86_setup_scratch_space') {
                            steps {
                                container('cuda-x86') {
                                    script {
                                        mountScratchSpace(createSymlink: true)
                                    }
                                }
                            }
                        }
                        
                        stage('x86_dependency_install') {
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        script {
                                            withCredentials([string(credentialsId: TaoConfig.credentials.NGC_CLI_KEY, variable: 'NGC_CLI_API_KEY')]) {
                                                env.NGC_KEY = NGC_CLI_API_KEY
                                                env.NGC_PATH = 'ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
                                            }
                                            withGitLabStatus('x86_dependency_install') {
                                                sh "pip install --no-build-isolation -e ."
                                                sh "CPUCOUNT=1 pip install tao-core/"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Functional tests (RC only)
                        stage('x86_functional_tests_rc') {
                            when {
                                expression { params.RC && !params.SKIP_TEST }
                            }
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                        withCredentials([
                                            string(credentialsId: TaoConfig.credentials.NGC_CLI_KEY, variable: 'NGC_CLI_API_KEY'),
                                            string(credentialsId: TaoConfig.credentials.HF_TOKEN, variable: 'HF_TOKEN')
                                        ]) {
                                            script {
                                                env.NGC_KEY = NGC_CLI_API_KEY
                                                env.HF_TOKEN = HF_TOKEN
                                            }
                                        }
                                        withGitLabStatus('x86_functional_tests_rc') {
                                            sh "pip install pytest-cov"
                                            sh "${env.COMMAND_ENV_X86} python3 ci/run_functional_tests.py --cov=nvidia_tao_pytorch --cov-report=xml:coverage.xml --cov-report=term"
                                            archiveArtifacts artifacts: 'coverage.xml', fingerprint: true, allowEmptyArchive: true
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('x86_build_wheel') {
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('x86_build_wheel') {
                                            script {
                                                buildWheel(
                                                    version: TAO_VERSION,
                                                    buildType: BUILD_TYPE,
                                                    buildNumber: env.BUILD_NUMBER,
                                                    isRC: params.RC,
                                                    useBuildInfo: true,
                                                    commandEnv: env.COMMAND_ENV_X86,
                                                    cleanEggInfo: true
                                                )
                                                
                                                // Capture Python version for metadata archiving
                                                env.PYTHON_VERSION = sh(
                                                    script: 'python -c "import platform; print(platform.python_version())"',
                                                    returnStdout: true
                                                ).trim()
                                                echo "Python version: ${env.PYTHON_VERSION}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // RC Wheel Publish
                        stage('x86_rc_wheel_publish') {
                            when {
                                expression { params.RC }
                            }
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('x86_rc_wheel_publish') {
                                            script {
                                                def RC_VER = "${MAJOR_MINOR}.${PATCH_NUMBER}${BUILD_TYPE}${BUILD_NUMBER}"
                                                def PYTHON_VER = "cp312-cp312"
                                                def ARCH = "linux_x86_64"
                                                def SRC = "dist/nvidia_tao_pytorch-${RC_VER}-${PYTHON_VER}-${ARCH}.whl"
                                                
                                                // Rename wheel to manylinux1 platform tag for compatibility
                                                sh "cp ${SRC} dist/nvidia_tao_pytorch-${RC_VER}-${PYTHON_VER}-manylinux1_x86_64.whl"
                                                
                                                def rcPublishResult = publishWheel(
                                                    version: RC_VER,
                                                    componentName: COMPONENT_NAME,
                                                    pythonVersion: PYTHON_VER,
                                                    manylinuxPlatform: 'manylinux1_x86_64',
                                                    releaseApprover: RELEASE_APPROVER
                                                )
                                                rcWheelInstallLocation = rcPublishResult.wheelInstallLocation
                                                
                                                // Store in environment for cross-stage access
                                                env.RC_WHEEL_INSTALL_LOC = rcWheelInstallLocation
                                                
                                                echo "✓ RC wheel published: ${RC_VER}"
                                                echo "Install location: ${rcWheelInstallLocation}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Final Wheel Publish - skipped if SKIP_PROD_PROMOTE is true
                        stage('x86_final_wheel_publish') {
                            when {
                                expression { !SKIP_PROD_PROMOTE }
                            }
                            steps {
                                container('cuda-x86') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('x86_final_wheel_publish') {
                                            script {
                                                def PYTHON_VER = "cp312-cp312"
                                                def ARCH = "linux_x86_64"
                                                
                                                // For RC builds, rebuild wheel with non-RC version
                                                if (params.RC) {
                                                    echo "Rebuilding wheel with non-RC version for final release..."
                                                    buildWheel.rebuildFinal(
                                                        version: FINAL_VER,
                                                        commandEnv: env.COMMAND_ENV_X86
                                                    )
                                                }
                                                
                                                def SRC = "dist/nvidia_tao_pytorch-${FINAL_VER}-${PYTHON_VER}-${ARCH}.whl"
                                                
                                                // Rename wheel to manylinux1 platform tag for compatibility
                                                sh "cp ${SRC} dist/nvidia_tao_pytorch-${FINAL_VER}-${PYTHON_VER}-manylinux1_x86_64.whl"
                                                
                                                def finalPublishResult = publishWheel(
                                                    version: FINAL_VER,
                                                    componentName: COMPONENT_NAME,
                                                    pythonVersion: PYTHON_VER,
                                                    manylinuxPlatform: 'manylinux1_x86_64',
                                                    releaseApprover: RELEASE_APPROVER,
                                                    overwrite: true
                                                )
                                                finalWheelInstallLocation = finalPublishResult.wheelInstallLocation
                                                
                                                // Store in environment for cross-stage access
                                                env.FINAL_WHEEL_INSTALL_LOC = finalWheelInstallLocation
                                                
                                                echo "✓ Final wheel published: ${FINAL_VER}"
                                                echo "Install location: ${finalWheelInstallLocation}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('x86_cleanup_scratch_space') {
                            steps {
                                container('cuda-x86') {
                                    script {
                                        unmountScratchSpace(removeSymlink: true)
                                    }
                                }
                            }
                        }
                        
                        stage('x86_setup_scratch_space_dind') {
                            steps {
                                container('dind-image') {
                                    script {
                                        mountScratchSpace(createSymlink: true)
                                    }
                                }
                            }
                        }
                        
                        // SonarQube Analysis (RC only)
                        stage('x86_sonarqube_analysis_rc') {
                            when {
                                expression { params.RC }
                            }
                            steps {
                                container('dind-image') {
                                    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                        withGitLabStatus('x86_sonarqube_analysis_rc') {
                                            script {
                                                def branchName = params.GITLAB_BRANCH ?: env.BRANCH_NAME ?: env.GIT_BRANCH?.replaceFirst(/^origin\//, '') ?: 'main'
                                                docker.image(TaoConfig.images.SONAR_SCANNER).inside() {
                                                    withSonarQubeEnv() {
                                                        sh "sonar-scanner -Dsonar.python.coverage.reportPaths=coverage.xml -Dsonar.sources=nvidia_tao_pytorch -Dsonar.tests=tests -Dsonar.branch.name=${branchName}"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Docker Build and Push
                        stage('x86_build_publish_docker') {
                            steps {
                                container('dind-image') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        script {
                                            retry(count: 3) {
                                                script {
                                                    if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                                                        echo "Previous attempt failed, sleeping 5 minutes before retry..."
                                                        sleep time: 5, unit: 'MINUTES'
                                                    }
                                                }
                                                withGitLabStatus('x86_build_publish_docker') {
                                                    def IMAGE_NAME = params.RC ? TaoConfig.images.IMAGE_NAME_PYT : TaoConfig.images.IMAGE_NAME_TOOLKIT
                                                    def IMAGE_TAG = params.RC ? "${TAO_VERSION}-rc-${BUILD_NUMBER}-x86" : "${TAO_VERSION}-pyt-x86"
                                                    
                                                    // Build Docker image
                                                    def buildResult = buildDockerImage(
                                                        imageName: IMAGE_NAME,
                                                        tag: IMAGE_TAG,
                                                        dockerfile: '${WORKSPACE}/release/docker/Dockerfile',
                                                        context: '${WORKSPACE}',
                                                        arch: 'amd64',
                                                        registryUrl: 'https://nvcr.io',
                                                        registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                    )
                                                    
                                                    // Push Docker image
                                                    pushDockerImage(
                                                        imageName: buildResult.imageName,
                                                        tag: buildResult.tag,
                                                        registry: 'https://nvcr.io',
                                                        registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                    )
                                                    
                                                    // Store image tag for metadata
                                                    env.DOCKER_IMAGE_TAG_X86 = buildResult.fullName
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Coverage Docker Build (RC only)
                        stage('x86_docker_coverage_build_rc') {
                            when {
                                expression { params.RC }
                            }
                            steps {
                                container('dind-image') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        script {
                                            retry(count: 3) {
                                                script {
                                                    if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                                                        echo "Previous attempt failed, sleeping 5 minutes before retry..."
                                                        sleep time: 5, unit: 'MINUTES'
                                                    }
                                                }
                                                withGitLabStatus('x86_docker_coverage_build_rc') {
                                                    def CC_IMAGE_TAG = "${TAO_VERSION}-rc-${BUILD_NUMBER}-cc-x86"
                                                    
                                                    // Build coverage Docker image
                                                    def buildResult = buildDockerImage(
                                                        imageName: TaoConfig.images.IMAGE_NAME_PYT,
                                                        tag: CC_IMAGE_TAG,
                                                        dockerfile: '${WORKSPACE}/release/docker/Dockerfile',
                                                        context: '${WORKSPACE}',
                                                        arch: 'amd64',
                                                        appendToDockerfile: 'coverage_build.txt',
                                                        registryUrl: 'https://nvcr.io',
                                                        registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                    )
                                                    
                                                    // Push coverage Docker image
                                                    pushDockerImage(
                                                        imageName: buildResult.imageName,
                                                        tag: buildResult.tag,
                                                        registry: 'https://nvcr.io',
                                                        registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                    )
                                                    
                                                    // Store CC image tag
                                                    env.DOCKER_CC_IMAGE_TAG_X86 = buildResult.fullName
                                                    
                                                    echo "Coverage Docker image published: ${buildResult.fullName}"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('x86_cleanup_scratch_space_dind') {
                            steps {
                                container('dind-image') {
                                    script {
                                        unmountScratchSpace(removeSymlink: true)
                                    }
                                }
                            }
                        }
                    }
                }
                
                // ================================================================
                // ARM BUILD
                // ================================================================
                stage('arm') {
                    agent {
                        kubernetes {
                            cloud TaoConfig.kubernetes.cloud
                            yaml PodTemplates.generate(
                                label: 'tao-pytorch-release-arm64',
                                containers: ['dind-image', 'cuda-arm64'],
                                affinityPool: 'tao-gpu-arm64-pool'
                            )
                        }
                    }
                    
                    stages {
                        stage('arm_checkout') {
                            steps {
                                container('cuda-arm64') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('arm_checkout') {
                                            checkoutWithSafeDirectory()
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('arm_gpu_check') {
                            steps {
                                container('cuda-arm64') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('arm_gpu_check') {
                                            gpuCheck()
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('arm_setup') {
                            steps {
                                container('cuda-arm64') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('arm_setup') {
                                            script {
                                                sh "source scripts/envsetup.sh"
                                                def workspace_path = pwd()
                                                env.COMMAND_ENV_ARM = "PYTHONPATH=${workspace_path}:\$PYTHONPATH CI_PROJECT_DIR=${workspace_path}"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('arm_patch_build_files') {
                            steps {
                                container('cuda-arm64') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('arm_patch_build_files') {
                                            patchVersion(
                                                version: TAO_VERSION,
                                                script: 'release/update_version.py'
                                            )
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('arm_setup_scratch_space') {
                            steps {
                                container('cuda-arm64') {
                                    script {
                                        mountScratchSpace(createSymlink: true)
                                    }
                                }
                            }
                        }
                        
                        stage('arm_dependency_install') {
                            steps {
                                container('cuda-arm64') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        script {
                                            withCredentials([string(credentialsId: TaoConfig.credentials.NGC_CLI_KEY, variable: 'NGC_CLI_API_KEY')]) {
                                                env.NGC_KEY = NGC_CLI_API_KEY
                                                env.NGC_PATH = 'ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
                                            }
                                            withGitLabStatus('arm_dependency_install') {
                                                sh "pip install --no-build-isolation -e ."
                                                sh "CPUCOUNT=1 pip install tao-core/"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('arm_build_wheel') {
                            steps {
                                container('cuda-arm64') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        withGitLabStatus('arm_build_wheel') {
                                            script {
                                                buildWheel(
                                                    version: TAO_VERSION,
                                                    buildType: BUILD_TYPE,
                                                    buildNumber: env.BUILD_NUMBER,
                                                    isRC: params.RC,
                                                    useBuildInfo: true,
                                                    commandEnv: env.COMMAND_ENV_ARM,
                                                    cleanEggInfo: true
                                                )
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('arm_cleanup_scratch_space') {
                            steps {
                                container('cuda-arm64') {
                                    script {
                                        unmountScratchSpace(removeSymlink: true)
                                    }
                                }
                            }
                        }
                        
                        stage('arm_setup_scratch_space_dind') {
                            steps {
                                container('dind-image') {
                                    script {
                                        mountScratchSpace(createSymlink: true)
                                    }
                                }
                            }
                        }
                        
                        // Docker Build and Push
                        stage('arm_build_publish_docker') {
                            steps {
                                container('dind-image') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        script {
                                            retry(count: 3) {
                                                script {
                                                    if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                                                        echo "Previous attempt failed, sleeping 5 minutes before retry..."
                                                        sleep time: 5, unit: 'MINUTES'
                                                    }
                                                }
                                                withGitLabStatus('arm_build_publish_docker') {
                                                    def IMAGE_NAME = params.RC ? TaoConfig.images.IMAGE_NAME_PYT : TaoConfig.images.IMAGE_NAME_TOOLKIT
                                                    def IMAGE_TAG = params.RC ? "${TAO_VERSION}-rc-${BUILD_NUMBER}-arm64" : "${TAO_VERSION}-pyt-arm64"
                                                    
                                                    // Build Docker image
                                                    def buildResult = buildDockerImage(
                                                        imageName: IMAGE_NAME,
                                                        tag: IMAGE_TAG,
                                                        dockerfile: '${WORKSPACE}/release/docker/Dockerfile',
                                                        context: '${WORKSPACE}',
                                                        arch: 'arm64',
                                                        registryUrl: 'https://nvcr.io',
                                                        registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                    )
                                                    
                                                    // Push Docker image
                                                    pushDockerImage(
                                                        imageName: buildResult.imageName,
                                                        tag: buildResult.tag,
                                                        registry: 'https://nvcr.io',
                                                        registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                    )
                                                    
                                                    // Store image tag for metadata
                                                    env.DOCKER_IMAGE_TAG_ARM64 = buildResult.fullName
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        // Coverage Docker Build (RC only)
                        stage('arm_docker_coverage_build_rc') {
                            when {
                                expression { params.RC }
                            }
                            steps {
                                container('dind-image') {
                                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                        script {
                                            retry(count: 3) {
                                                script {
                                                    if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                                                        echo "Previous attempt failed, sleeping 5 minutes before retry..."
                                                        sleep time: 5, unit: 'MINUTES'
                                                    }
                                                }
                                                withGitLabStatus('arm_docker_coverage_build_rc') {
                                                    def CC_IMAGE_TAG = "${TAO_VERSION}-rc-${BUILD_NUMBER}-cc-arm64"
                                                    
                                                    // Build coverage Docker image
                                                    def buildResult = buildDockerImage(
                                                        imageName: TaoConfig.images.IMAGE_NAME_PYT,
                                                        tag: CC_IMAGE_TAG,
                                                        dockerfile: '${WORKSPACE}/release/docker/Dockerfile',
                                                        context: '${WORKSPACE}',
                                                        arch: 'arm64',
                                                        appendToDockerfile: 'coverage_build.txt',
                                                        registryUrl: 'https://nvcr.io',
                                                        registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                    )
                                                    
                                                    // Push coverage Docker image
                                                    pushDockerImage(
                                                        imageName: buildResult.imageName,
                                                        tag: buildResult.tag,
                                                        registry: 'https://nvcr.io',
                                                        registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                    )
                                                    
                                                    // Store CC image tag
                                                    env.DOCKER_CC_IMAGE_TAG_ARM64 = buildResult.fullName
                                                    
                                                    echo "Coverage Docker image published: ${buildResult.fullName}"
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        
                        stage('arm_cleanup_scratch_space_dind') {
                            steps {
                                container('dind-image') {
                                    script {
                                        unmountScratchSpace(removeSymlink: true)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        
        // ================================================================
        // CONSOLIDATE MULTI-ARCH IMAGES AND ARCHIVE METADATA
        // ================================================================
        stage('consolidate_and_archive') {
            when {
                expression { env.SKIP_BUILD != 'true' }
            }
            agent {
                kubernetes {
                    cloud TaoConfig.kubernetes.cloud
                    yaml PodTemplates.generate(
                        label: 'tao-pytorch-consolidate',
                        containers: ['docker-consolidate'],
                        affinityPool: 'docker-only'
                    )
                }
            }
            
            stages {
                stage('consolidate_multiarch_image') {
                    steps {
                        container('docker-consolidate') {
                            retry(count: 3) {
                                script {
                                    if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                                        echo "Previous attempt failed, sleeping 5 minutes before retry..."
                                        sleep time: 5, unit: 'MINUTES'
                                    }
                                }
                                withGitLabStatus('consolidate_multiarch_image') {
                                    script {
                                        echo "=== Consolidating Multi-Architecture Images ==="
                                        
                                        def IMAGE_NAME_PYT = TaoConfig.images.IMAGE_NAME_PYT
                                        def IMAGE_NAME_TOOLKIT = TaoConfig.images.IMAGE_NAME_TOOLKIT
                                        
                                        if (params.RC) {
                                            def rcTag = "${TAO_VERSION}-rc-${BUILD_NUMBER}"
                                            
                                            // RC multiarch manifest
                                            createMultiArchManifest(
                                                imageName: IMAGE_NAME_PYT,
                                                manifestTag: "${rcTag}-multiarch",
                                                sourceTags: ["${rcTag}-x86", "${rcTag}-arm64"],
                                                registry: 'https://nvcr.io',
                                                registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                            )
                                            env.MULTIARCH_IMAGE_TAG = "${IMAGE_NAME_PYT}:${rcTag}-multiarch"
                                            
                                            // Also tag as latest version (skipped if SKIP_PROD_PROMOTE is true)
                                            if (!SKIP_PROD_PROMOTE) {
                                                createMultiArchManifest(
                                                    manifestImage: "${IMAGE_NAME_TOOLKIT}:${TAO_VERSION}-pyt",
                                                    sourceImages: [
                                                        "${IMAGE_NAME_PYT}:${rcTag}-x86",
                                                        "${IMAGE_NAME_PYT}:${rcTag}-arm64"
                                                    ],
                                                    registry: 'https://nvcr.io',
                                                    registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                                )
                                            } else {
                                                echo "⏭ Skipping production image tagging (SKIP_PROD_PROMOTE = true)"
                                            }
                                            
                                            // CC multiarch manifest
                                            createMultiArchManifest(
                                                imageName: IMAGE_NAME_PYT,
                                                manifestTag: "${rcTag}-cc-multiarch",
                                                sourceTags: ["${rcTag}-cc-x86", "${rcTag}-cc-arm64"],
                                                registry: 'https://nvcr.io',
                                                registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                            )
                                            env.CC_MULTIARCH_IMAGE_TAG = "${IMAGE_NAME_PYT}:${rcTag}-cc-multiarch"
                                            
                                        } else {
                                            // Final release multiarch manifest
                                            createMultiArchManifest(
                                                imageName: IMAGE_NAME_TOOLKIT,
                                                manifestTag: "${TAO_VERSION}-pyt",
                                                sourceTags: ["${TAO_VERSION}-pyt-x86", "${TAO_VERSION}-pyt-arm64"],
                                                registry: 'https://nvcr.io',
                                                registryCredentialsId: TaoConfig.credentials.NGC_API_KEY
                                            )
                                            env.MULTIARCH_IMAGE_TAG = "${IMAGE_NAME_TOOLKIT}:${TAO_VERSION}-pyt"
                                        }
                                        
                                        echo "✓ Multi-arch image consolidation complete"
                                        echo "Multiarch image: ${env.MULTIARCH_IMAGE_TAG}"
                                    }
                                }
                            }
                        }
                    }
                }
                
                stage('archive_metadata') {
                    steps {
                        container('docker-consolidate') {
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                withGitLabStatus('archive_metadata') {
                                    script {
                                        // Retrieve wheel install locations from environment
                                        def rcWheelLoc = env.RC_WHEEL_INSTALL_LOC ?: ''
                                        def finalWheelLoc = env.FINAL_WHEEL_INSTALL_LOC ?: ''
                                        def multiarchImage = env.MULTIARCH_IMAGE_TAG ?: ''
                                        def ccMultiarchImage = env.CC_MULTIARCH_IMAGE_TAG ?: ''
                                        def x86Image = env.DOCKER_IMAGE_TAG_X86 ?: ''
                                        def arm64Image = env.DOCKER_IMAGE_TAG_ARM64 ?: ''
                                        
                                        def pythonVer = env.PYTHON_VERSION ?: 'unknown'
                                        
                                        echo "=== Archiving Release Metadata ==="
                                        echo "RC Wheel Install Location: ${rcWheelLoc}"
                                        echo "Final Wheel Install Location: ${finalWheelLoc}"
                                        echo "Multiarch Docker Image: ${multiarchImage}"
                                        echo "X86 Docker Image: ${x86Image}"
                                        echo "ARM64 Docker Image: ${arm64Image}"
                                        echo "Python Version: ${pythonVer}"
                                        
                                        archiveReleaseMetadata(
                                            taoVersion: TAO_VERSION,
                                            wheelVersion: VER,
                                            isRC: params.RC,
                                            forceRebuild: params.FORCE_REBUILD,
                                            skipProdPromote: SKIP_PROD_PROMOTE,
                                            componentName: COMPONENT_NAME,
                                            wheelInstallLocation: rcWheelLoc,
                                            finalWheelInstallLocation: finalWheelLoc,
                                            pythonVersion: pythonVer,
                                            // Additional image metadata
                                            additionalMetadata: [
                                                docker_images: [
                                                    multiarch: multiarchImage,
                                                    x86: x86Image,
                                                    arm64: arm64Image,
                                                    cc_multiarch: ccMultiarchImage
                                                ]
                                            ]
                                        )
                                        
                                        echo "✓ Release metadata archived successfully"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo "=== Build Complete: ${currentBuild.result ?: 'SUCCESS'} ==="
            }
        }
        failure {
            node('master') {
                script {
                    echo "Build failed"
                    createJiraIssue(
                        summary: "tao-pytorch Release Build Failed - ${TAO_VERSION}",
                        description: "Build ${BUILD_NUMBER} failed. Check ${BUILD_URL}"
                    )
                }
            }
        }
    }
}
