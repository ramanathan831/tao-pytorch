// Global variables - Version is passed to release/update_version.py to patch build files
def TAO_VERSION = params.TAO_VERSION ?: "6.25.10"
def BUILD_TYPE = "rc"

// Normalize patch segment if TAO_VERSION is provided via params (e.g., 6.25.09 -> 6.25.9)
if (params.TAO_VERSION) {
  def _parts = TAO_VERSION.split('\\.')
  if (_parts.length >= 3) {
    def _patchNorm = _parts[-1]
    try {
      _patchNorm = Integer.parseInt(_patchNorm).toString()
    } catch (Exception ignore) {
      // leave as-is if not numeric
    }
    TAO_VERSION = "${_parts[0]}.${_parts[1]}.${_patchNorm}"
  }
}

def getPulseToken() {
    def token
    echo "Getting Pulse token..."

    sh "apk update"
    sh "apk add curl jq wget python3 py3-pip"

    withCredentials([usernamePassword(credentialsId: 'pulse-client-credentials',
                                      usernameVariable: 'CLIENT_ID',
                                      passwordVariable: 'CLIENT_SECRET')]) {
        token = sh(script: """
            curl --location --request POST 'https://x9thwm-cootr2q1jdv5p7b8iw4fs4ob3x6nqqsoznyk.ssa.nvidia.com/token' \
                --user "$CLIENT_ID:$CLIENT_SECRET" \
                --header 'Content-Type: application/x-www-form-urlencoded' \
                --data-urlencode 'grant_type=client_credentials' \
                --data-urlencode 'scope=nspect.verify scan.anchore' | jq -r '.access_token'
        """, returnStdout: true).trim()
    }

    echo "${token}"
    return token
}


podTemplate (cloud:'sc-ipp-blossom-prod', yaml : """
apiVersion: v1
kind: Pod
metadata:
  labels:
    some-label: some-label-value
spec:
  imagePullSecrets:
  - name: svc-tlt-ci-ngcimagepullsecret
  - name: gitlab-tao-imagepullsecret
  containers:
  - name: docker
    image: docker:24.0.5-dind
    securityContext:
      privileged: true
    resources:
      requests:
        memory: "32Gi"
      limits:
        memory: "64Gi"
    env:
      - name: DOCKER_TLS_CERTDIR
        value: ""
  - name: base-image
    image: nvcr.io/nvstaging/tao/tao_pytorch_base_image@sha256:4d6c2f98bcb233a7ab7c87f187b3d5a3e1c405d1206fb2b0d3c7b410bb93e84d
    securityContext:
      privileged: true
    command:
    - cat
    resources:
      requests:
        nvidia.com/gpu: 1
        memory: "16Gi"
      limits:
        nvidia.com/gpu: 1
        memory: "64Gi"
    tty: true
  restartPolicy: Never
  backoffLimit: 4
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
        - matchExpressions:
          - key: nvidia.com/gpu_type
            operator: In
            values:
            - A100_80GB_PCIE
            - A100_PCIE_80GB
          - key: nvidia.com/driver_version
            operator: In
            values:
            - 580.35
            - 580.66
            - 580.82.07
          - key: kubernetes.io/os
            operator: In
            values:
            - linux
""") {
  node(POD_LABEL) {
    try {
      container('base-image') {
        def command_env = ''

        stage ('checkout') {
          gitlabCommitStatus(name: "checkout", connection: gitLabConnection('git-lab-master')) {
            checkout scm
            sh "git config --global --add safe.directory $WORKSPACE && ls -lrt"
          }
        }

        stage('update_core_submodule') {
          gitlabCommitStatus(name: "update_core_submodule", connection: gitLabConnection('git-lab-master')) {
            withCredentials([string(credentialsId: 'gitlab-api-token', variable: 'GITLAB_TOKEN')]) {
              // Determine the release branch from TAO_VERSION
              def releaseBranch = "release/${TAO_VERSION}"
              echo "Target release branch: ${releaseBranch}"
              
              // Save original .gitmodules
              sh "cp .gitmodules .gitmodules.backup"
              
              try {
                // Configure git to use the token for authentication
                sh """
                  git config --global credential.helper store
                  echo "https://oauth2:${GITLAB_TOKEN}@gitlab-master.nvidia.com" > ~/.git-credentials
                """
                
                // Fetch the release branch and checkout
                sh """
                  git fetch origin ${releaseBranch}
                  git checkout ${releaseBranch} || git checkout -b ${releaseBranch} origin/${releaseBranch}
                """
                
                // Temporarily update submodule URL to HTTPS with authentication
                sh """
                  git config -f .gitmodules submodule.tao-core.url https://gitlab-master.nvidia.com/nvidia-tao-toolkit/tao-core.git
                  git config -f .gitmodules submodule.tao-core.branch ${releaseBranch}
                """
                
                // Initialize and update submodule to latest from the branch
                sh """
                  git submodule sync
                  git submodule update --init --remote tao-core
                """
                
                // Mark tao-core submodule as safe directory and print SHA
                sh "git config --global --add safe.directory $WORKSPACE/tao-core"
                def coreCommitSha = sh(script: "cd tao-core && git rev-parse HEAD", returnStdout: true).trim()
                echo "tao-core submodule SHA: ${coreCommitSha}"
                
                // Check if there are changes in the submodule
                def submoduleStatus = sh(script: "git status --porcelain tao-core", returnStdout: true).trim()
                
                if (submoduleStatus) {
                  echo "Submodule tao-core has updates. Committing the new SHA..."
                  
                  // Restore original .gitmodules (don't commit the branch or URL change)
                  sh "mv .gitmodules.backup .gitmodules"
                  
                  // Stage only the submodule change
                  sh "git add tao-core"
                  
                  // Commit and push
                  sh """
                    git config user.email "christwang@nvidia.com"
                    git config user.name "TAO Release CI"
                    git commit -m "TAO Release CI - update core submodule"
                    git push https://oauth2:${GITLAB_TOKEN}@gitlab-master.nvidia.com/nvidia-tao-toolkit/tao-pytorch.git HEAD:${releaseBranch}
                  """
                  
                  echo "Successfully updated and pushed tao-core submodule to ${releaseBranch}"
                } else {
                  echo "No updates needed for tao-core submodule"
                  // Restore original .gitmodules
                  sh "mv .gitmodules.backup .gitmodules"
                }
              } catch (Exception e) {
                // Restore original .gitmodules in case of error
                sh "mv .gitmodules.backup .gitmodules || true"
                throw e
              } finally {
                // Clean up all git credentials and credential files
                sh """
                  rm -f ~/.git-credentials || true
                  rm -f ~/.gitconfig || true
                  git config --global --unset credential.helper || true
                  # Remove any .git-credentials files in the workspace
                  find $WORKSPACE -name '.git-credentials' -type f -delete || true
                """
              }
            }
          }
        }

        stage ('patch_build_files') {
          gitlabCommitStatus(name: "patch_build_files", connection: gitLabConnection('git-lab-master')) {
            sh "python3 release/update_version.py --version ${TAO_VERSION}"
            echo "Build files patched with version ${TAO_VERSION}"
          }
        }

        stage ('setup') {
          gitlabCommitStatus(name: "setup", connection: gitLabConnection('git-lab-master')) {
            sh "ls -rlt ./"
            sh "ls -lh ./tests/"
            sh "source scripts/envsetup.sh"
            def workspace_path = pwd()
            def pythonpath_env = 'PYTHONPATH=' + workspace_path + ':$PYTHONPATH'
            def ci_path_env = 'CI_PROJECT_DIR=' + workspace_path
            command_env = pythonpath_env + ' ' + ci_path_env
          }
        }

        stage ('setup_scratch_space') {
          sh 'apt-get update'
          sh 'apt-get install cifs-utils -y'
          sh 'env | sort'
          sh 'mkdir -p /home/scratch.metropolis2'
          sh 'ls -l /home/scratch.metropolis2'
          withCredentials([usernamePassword(credentialsId: 'svc-tlt-ci-mount', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]){
            sh 'mount -t cifs -o "vers=2.0,username=${USERNAME},password=${PASSWORD},dom=nvidia.com,dir_mode=0777,file_mode=0777" //dc2-cdot49-sw-svm02/scratch.metropolis2 /home/scratch.metropolis2'
          }
          sh 'ls -l /home/scratch.metropolis2'
        }
      }

      container("docker"){
        stage ('setup_scratch_space_in_dind') {
          sh 'uname -a'
          sh 'apk update'
          sh 'apk add cifs-utils python3 py3-pip'
          sh 'python3 -V'
          sh 'python3 -m pip install pyyaml'
          sh 'ls /sbin/mount.cifs'
          sh 'env | sort'
          sh 'ls -lrt; pwd'
          sh 'df -h'
          sh 'mkdir -p /home/scratch.metropolis2'
          sh 'ls -l /home/scratch.metropolis2'
          withCredentials([usernamePassword(credentialsId: 'svc-tlt-ci-mount', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]){
            sh 'mount -t cifs -o "vers=2.0,username=${USERNAME},password=${PASSWORD},dom=nvidia.com,dir_mode=0777,file_mode=0777" //dc2-cdot49-sw-svm02/scratch.metropolis2 /home/scratch.metropolis2'
          }
          sh 'df -h'
          sh 'ls -l /home/scratch.metropolis2'
        }


      }
      
      container('base-image') {
        def workspace_path = pwd()
        def pythonpath_env = 'PYTHONPATH=' + workspace_path + ':$PYTHONPATH'
        def ci_path_env = 'CI_PROJECT_DIR=' + workspace_path
        command_env = pythonpath_env + ' ' + ci_path_env

        stage ("functional_tests") {
          // Only run functional tests for RC builds
          withCredentials([
            string(credentialsId: 'NGC_CLI_API_KEY_SVC_TLT_CI', variable: 'NGC_CLI_API_KEY'),
            string(credentialsId: 'HF_TOKEN_CI', variable: 'HF_TOKEN')
          ]) {
            script{
              env.NGC_KEY=NGC_CLI_API_KEY
              env.NGC_PATH='ea-tlt/tao_ea/pretrained_dino_imagenet:fan_hybrid_tiny'
              env.HF_TOKEN=HF_TOKEN
            }
          }
          gitlabCommitStatus(name: "functional_tests", connection: gitLabConnection('git-lab-master')) {
            if (params.RC) {
              sh "python setup.py develop"
              sh "CPUCOUNT=1 pip install tao-core/"
              sh "pip install pytest-cov"
              sh "${command_env} python3 ci/run_functional_tests.py --cov=nvidia_tao_pytorch --cov-report=xml:coverage.xml --cov-report=term"
              archiveArtifacts artifacts: 'coverage.xml', fingerprint: true, allowEmptyArchive: true
            } else {
              echo "Skipping functional tests for non-RC build"
            }
          }
        }
      }

      container("docker") {
        stage ('sonarqube_analysis') {
          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            // Only run SonarQube analysis for RC builds
            gitlabCommitStatus(name: "sonarqube_analysis", connection: gitLabConnection('git-lab-master')) {
              if (params.RC) {
                def branchName = params.GITLAB_BRANCH ?: params.BRANCH_NAME ?: env.BRANCH_NAME ?: env.GIT_BRANCH?.replaceFirst(/^origin\//, '') ?: 'main'
                echo "Analyzing branch: ${branchName}"
                echo "Available parameters: GITLAB_BRANCH=${params.GITLAB_BRANCH}, BRANCH_NAME=${params.BRANCH_NAME}"
                echo "Available env vars: BRANCH_NAME=${env.BRANCH_NAME}, GIT_BRANCH=${env.GIT_BRANCH}"
                
                docker.image('sonarsource/sonar-scanner-cli:11').inside() {
                  withSonarQubeEnv() {
                    sh "sonar-scanner -Dsonar.python.coverage.reportPaths=coverage.xml -Dsonar.sources=nvidia_tao_pytorch -Dsonar.tests=tests -Dsonar.branch.name=${branchName}"
                  }
                }
                echo "SonarQube analysis completed successfully"
              } else {
                echo "Skipping SonarQube analysis for non-RC build"
              }
            }
          }
        }
      }

      container('base-image') {
        stage ('build_wheel') {
          gitlabCommitStatus(name: "build_wheel", connection: gitLabConnection('git-lab-master')) {

            def VER
            if (params.RC) {
              VER = "${TAO_VERSION}.${BUILD_TYPE}${BUILD_NUMBER}"
            } else {
              VER = "${TAO_VERSION}"
            }

            def VERSION_PARTS = TAO_VERSION.split('\\.')
            def PATCH_NUMBER = VERSION_PARTS[-1]
            
            if (params.RC) {
              sh "echo '${PATCH_NUMBER}${BUILD_TYPE}${BUILD_NUMBER}' > build.info"
            } else {

              sh "echo '${PATCH_NUMBER}' > build.info"
            }
            build_env = command_env
            sh "${build_env} python setup.py bdist_wheel"
            sh "pip install dist/nvidia_tao_pytorch-*.whl"
          }
        }
      }

      container('base-image') {
        def workspace_path = pwd()
        def pythonpath_env = 'PYTHONPATH=' + workspace_path + ':$PYTHONPATH'
        def ci_path_env = 'CI_PROJECT_DIR=' + workspace_path
        command_env = pythonpath_env + ' ' + ci_path_env

        stage ('wheel_publish') {
          gitlabCommitStatus(name: "obfuscated_wheel_publish", connection: gitLabConnection('git-lab-master')) {

            sh "bash ${WORKSPACE}/docker/install_jfrog.sh"
            

            def VERSION_PARTS = TAO_VERSION.split('\\.')
            def MAJOR_MINOR = "${VERSION_PARTS[0]}.${VERSION_PARTS[1]}"
            def PATCH_NUMBER = VERSION_PARTS[-1]
            
            def VER
            if (params.RC) {

              VER = "${MAJOR_MINOR}.${PATCH_NUMBER}${BUILD_TYPE}${BUILD_NUMBER}"
            } else {

              VER = "${MAJOR_MINOR}.${PATCH_NUMBER}"
            }
            def PYTHON_VER="cp312-cp312"
            def ARCH="linux_x86_64"
            def SRC = "dist/nvidia_tao_pytorch-${VER}-${PYTHON_VER}-${ARCH}.whl"
            def TARGET="sw-tao-pypi-local/nvidia-tao-pytorch/${VER}/"
            def PROP="component_name=nvidia-tao-pytorch;arch=x86_64;os=linux;build_source=None;version=${VER};branch=main;release_approver=vpraveen"
            
            withCredentials([usernamePassword(credentialsId: 'tao-artifactory-tkn', passwordVariable: 'JFROG_PASSWORD', usernameVariable: 'JFROG_USERNAME')]) {

              if (!params.RC) {
                echo "Checking for existing wheel asset..."
                def wheelPattern = "${TARGET}nvidia_tao_pytorch-${VER}-${PYTHON_VER}-${ARCH}.whl"
                echo "Searching for pattern: ${wheelPattern}"
                

                def searchStatus = sh(script: "jfrog rt s --url=https://urm.nvidia.com/artifactory/ --user=${JFROG_USERNAME} --access-token=${JFROG_PASSWORD} '${wheelPattern}' --count", returnStatus: true)
                def count = 0
                if (searchStatus == 0) {

                  count = Integer.parseInt(sh(script: "jfrog rt s --url=https://urm.nvidia.com/artifactory/ --user=${JFROG_USERNAME} --access-token=${JFROG_PASSWORD} '${wheelPattern}' --count", returnStdout: true).trim())
                } else {
                  echo "Search command returned non-zero (status=${searchStatus}). Treating as no existing wheel."
                }

                if (count > 0) {
                  echo "Found ${count} existing wheel(s). Removing..."
                  try {
                    sh "jfrog rt del --url=https://urm.nvidia.com/artifactory/ --user=${JFROG_USERNAME} --access-token=${JFROG_PASSWORD} '${wheelPattern}' --quiet"
                    echo "Successfully removed existing wheel"
                  } catch (Exception e) {
                    echo "Warning: Failed to delete existing wheel: ${e.getMessage()}"
                    echo "Continuing with upload..."
                  }
                } else {
                  echo "No existing wheel found (search count: ${count})"
                }
              }
              
              echo "Uploading wheel: ${SRC} to ${TARGET}"
              sh "cp ${SRC} dist/nvidia_tao_pytorch-${VER}-${PYTHON_VER}-manylinux1_x86_64.whl"
              sh "jfrog rt u --url=https://urm.nvidia.com/artifactory/ --user=${JFROG_USERNAME} --access-token=${JFROG_PASSWORD} --target-props '${PROP}' dist/nvidia_tao_pytorch-${VER}-${PYTHON_VER}-manylinux1_x86_64.whl ${TARGET}"
            }
            def append_string="pytorch_wheel: nvidia_tao_pytorch-${VER}-${PYTHON_VER}-${ARCH}.whl"
            def config_file_path = "/home/scratch.metropolis2/users/release_pipeline_files/release_items.yml"
            sh "python3 ci/update_release_config.py ${config_file_path} '${append_string}'"
            sh "cat /home/scratch.metropolis2/users/release_pipeline_files/release_items.yml"
          }
        }

        stage ('cleanup_scratch_space') {
          sh 'umount /home/scratch.metropolis2'
          sh 'ls -l /home/scratch.metropolis2'
        }
      }

      container("docker") {
        def IMAGE_NAME = "nvcr.io/nvstaging/tao/tao-toolkit-pyt"

        stage ('release_docker_build') {
          retry(count: 3) {

            script {
              if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                echo "Previous attempt failed, sleeping 5 minutes before retry..."
                sleep time: 5, unit: 'MINUTES'
              }
            }
            gitlabCommitStatus(name: "release_docker_build", connection: gitLabConnection('git-lab-master')) {
              docker.withRegistry('https://nvcr.io', 'NGC_API_KEY') {
                if (params.RC) {

                  def RC_IMAGE_TAG = "${TAO_VERSION}-${BUILD_TYPE}-${BUILD_NUMBER}"
                  sh "docker build -t ${IMAGE_NAME}:${RC_IMAGE_TAG} --network=host -f ${WORKSPACE}/release/docker/Dockerfile ${WORKSPACE}"
                  sh "docker push ${IMAGE_NAME}:${RC_IMAGE_TAG}"
                  

                  def UNIFIED_IMAGE_NAME = "nvcr.io/nvstaging/tao/tao-toolkit"
                  def UNIFIED_IMAGE_TAG = "${TAO_VERSION}-pyt"
                  sh "docker tag ${IMAGE_NAME}:${RC_IMAGE_TAG} ${UNIFIED_IMAGE_NAME}:${UNIFIED_IMAGE_TAG}"
                  sh "docker push ${UNIFIED_IMAGE_NAME}:${UNIFIED_IMAGE_TAG}"
                  
                  def append_string="pytorch: ${IMAGE_NAME}:${RC_IMAGE_TAG}"
                  def config_file_path = "/home/scratch.metropolis2/users/release_pipeline_files/release_items.yml"
                  sh "python3 ci/update_release_config.py ${config_file_path} '${append_string}'"
                  sh "cat /home/scratch.metropolis2/users/release_pipeline_files/release_items.yml"
                } else {

                  def UNIFIED_IMAGE_NAME = "nvcr.io/nvstaging/tao/tao-toolkit"
                  def UNIFIED_IMAGE_TAG = "${TAO_VERSION}-pyt"
                  

                  echo "Checking for existing Docker image..."
                  def imageExists = sh(script: "docker manifest inspect ${UNIFIED_IMAGE_NAME}:${UNIFIED_IMAGE_TAG} > /dev/null 2>&1", returnStatus: true)
                  if (imageExists == 0) {
                    echo "Existing image found. Note: Manual removal may be required from registry"
                  }
                  
                  sh "docker build -t ${UNIFIED_IMAGE_NAME}:${UNIFIED_IMAGE_TAG} --network=host -f ${WORKSPACE}/release/docker/Dockerfile ${WORKSPACE}"
                  sh "docker push ${UNIFIED_IMAGE_NAME}:${UNIFIED_IMAGE_TAG}"
                }
              }
            }
          }
        }

        stage ('docker_coverage_build') {
          // Only build coverage docker image for RC builds
          script {
            if (params.RC) {
              retry(count: 3) {
                // on retries, wait 5 min before re-running
                script {
                  if (currentBuild.getPreviousBuild()?.getResult() == 'FAILURE') {
                    echo "Previous attempt failed, sleeping 5 minutes before retry..."
                    sleep time: 5, unit: 'MINUTES'
                  }
                }
                gitlabCommitStatus(name: "docker_coverage_build", connection: gitLabConnection('git-lab-master')) {
                  docker.withRegistry('https://nvcr.io', 'NGC_API_KEY') {
                    def RC_IMAGE_TAG = "${TAO_VERSION}-${BUILD_TYPE}-${BUILD_NUMBER}"
                    sh "cat coverage_build.txt >> ${WORKSPACE}/release/docker/Dockerfile"
                    sh "cat ${WORKSPACE}/release/docker/Dockerfile"
                    sh "docker build -t ${IMAGE_NAME}:${RC_IMAGE_TAG}-cc --network=host -f ${WORKSPACE}/release/docker/Dockerfile ${WORKSPACE}"
                    sh "docker push ${IMAGE_NAME}:${RC_IMAGE_TAG}-cc"
                  }
                }
              }
            } else {
              echo "Skipping coverage docker build for non-RC build"
            }
          }
        }

        stage ('create_manifest') {
          gitlabCommitStatus(name: "create_manifest", connection: gitLabConnection('git-lab-master')) {
            docker.withRegistry('https://nvcr.io', 'NGC_API_KEY') {
              if (!params.RC) {
                def UNIFIED_IMAGE_NAME = "nvcr.io/nvstaging/tao/tao-toolkit"
                def SOURCE_TAG = "${TAO_VERSION}-pyt"
                def MANIFEST_TAG = "${TAO_VERSION}-release"
                sh "docker buildx imagetools create -t ${UNIFIED_IMAGE_NAME}:${MANIFEST_TAG} ${UNIFIED_IMAGE_NAME}:${SOURCE_TAG}"
              }
            }
          }
        }



        stage ('cleanup_scratch_space_in_dind') {
          sh 'umount /home/scratch.metropolis2'
          sh 'ls -l /home/scratch.metropolis2'
        }
      }
    }
    
    catch(e) {

      currentBuild.result = 'FAILURE'

      container('base-image') {
        stage("Jira Notification on Failure") {
          withCredentials([string(credentialsId: 'TAO-jira-token', variable: 'jira_token')]) {
            sh """
              python3 -m pip install jira
              python3 ci/create_jira_issue.py --jira_server "https://jirasw.nvidia.com/" \\
              --username "hqtran@nvidia.com" \\
              --api_token "${jira_token}" \\
              --project_key "TLT" \\
              --summary "Pipeline '${JOB_NAME}' Failure" \\
              --description \$'The pipeline "${JOB_NAME}" has failed.\nLink to the build: https://prod.blsm.nvidia.com/metropolis-iva-tlt-jenkins/view/tao-pytorch/job/${JOB_NAME}' \\
              --issue_type "Bug"
            """
          }
        }
      }
      

      throw e
    }
  }
}
